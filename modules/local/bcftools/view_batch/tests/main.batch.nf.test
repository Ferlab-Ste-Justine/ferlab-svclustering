/*
We drew significant inspiration from the nf-core bcftools/view module when writing the view_batch module.
The tests in main.nf.test are adaptations of those in the nf-core bcftools/view module. 
This file contains additional test cases specific to the bcftools view_batch module.

These tests assume that AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables exists and point on ferlab public dataset bucket on aws.
To run locally, you can execute this in the shell where the nf-test command is run. Substitute <your_profile> with the profile you want to use.
export AWS_ACCESS_KEY_ID=$(aws configure get aws_access_key_id --profile <your_profile>)
export AWS_SECRET_ACCESS_KEY=$(aws configure get aws_secret_access_key --profile <your_profile>)
*/

nextflow_process {

    name "Test Process BCFTOOLS_VIEW_BATCH - extra ferlab tests"
    script "../main.nf"
    process "BCFTOOLS_VIEW_BATCH"

    config "./nextflow.config"
    tag "local"

    test("Small1000GenomesChr22 - vanilla multi-samples case") {

        when {
            process {
                """
                meta1 = [id: "s1", prefix: 'sample_s1.test']
                vcf_file1 = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz', checkIfExists: true)
                tbi_file1 = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                meta2 = [id: "s2", prefix: 'sample_s2.test']
                vcf_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz', checkIfExists: true)
                tbi_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                
                input[0] = [
                    [meta1, meta2], 
                    [vcf_file1, vcf_file2],
                    [tbi_file1, tbi_file2]
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.vcf.size() == 1},
                { assert process.out.tbi.size() == 0},
                { assert process.out.csi.size() == 0},
                { assert snapshot(
                    process.out.vcf,
                    process.out.versions
                ).match()
                }
            )
        }
    }

    test("Small1000GenomesChr22 - multi-samples case - with tbi") {
        config "./vcf_gz_index_tbi.config"

        when {
            process {
                """
                meta1 = [ id:'s1', prefix: 'sample_s1.test']
                vcf_file1 = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz', checkIfExists: true)
                tbi_file1 = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                meta2 = [ id:'sample2', prefix: 'sample_s2.test']
                vcf_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz', checkIfExists: true)
                tbi_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                
                input[0] = [
                    [meta1, meta2], 
                    [vcf_file1, vcf_file2],
                    [tbi_file1, tbi_file2]
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.vcf.size() == 1},
                { assert process.out.tbi.size() == 1},
                { assert process.out.csi.size() == 0},
                { assert snapshot(
                    process.out.vcf,
                    process.out.tbi.collect { meta_list, tbi_files ->
                        def tbi_file_names = tbi_files.collect{ file(it).name }
                        [meta_list, tbi_file_names]
                    },
                    process.out.versions
                ).match()
                }
            )
        }
    }

    test("Small1000GenomesChr22 - stub multi-samples case") {

        options "-stub"

        when {
            process {
                """
                meta1 = [ id:'sample1', prefix: 'sample_s1.test']
                vcf_file1 = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz', checkIfExists: true)
                tbi_file1 = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                meta2 = [ id:'sample2', prefix: 'sample_s2.test']
                vcf_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz', checkIfExists: true)
                tbi_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                
                input[0] = [
                    [meta1, meta2], 
                    [vcf_file1, vcf_file2],
                    [tbi_file1, tbi_file2]
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.vcf.size() == 1},
                { assert process.out.tbi.size() == 0},
                { assert process.out.csi.size() == 0},
                { assert snapshot(
                    process.out.vcf[0][1].collect{file(it).name},
                    process.out.versions
                ).match() }
            )
        }
    }

    test("Small1000GenomesChr22 - with bcftools error for one file") {
        when {
            process {
                """
                meta1 = [id: "s1", prefix: 'sample_s1.test']
                invalid_vcf_file = file(params.modules_testdata_base_path + 'vcf/NA07019.chr22.cnv.vcf.gz.tbi', checkIfExists: true)
                meta2 = [id: "s2", prefix: 'sample_s2.test']
                vcf_file2 = file(params.modules_testdata_base_path + 'vcf/NA07022.chr22.cnv.vcf.gz', checkIfExists: true)

                input[0] = [
                    [meta1, meta2], 
                    [invalid_vcf_file, vcf_file2],
                    []
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Failed to read from NA07019.chr22.cnv.vcf.gz.tbi: Exec format error")}
            )
        }
    }
}
